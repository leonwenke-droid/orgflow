# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database URL for migrations (password: URL-encode special chars, e.g. ; = %3B)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Optional: if direct host is unreachable (e.g. project paused), use Session mode URI from Dashboard > Settings > Database
# DATABASE_POOLER_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: cron secret for shift reminder endpoint (GET /api/cron/shift-reminders)
# CRON_SECRET=your-secret

# Stripe Billing
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Pro günstiger Tarif (bis 49 Mitgl., z. B. 29 €) → plan "team"
# STRIPE_PRICE_TEAM=price_...
# Pro erweitert ab 50 Mitgliedern (z. B. 49 €) → plan "pro"
# STRIPE_PRICE_TEAM_SCALE=price_...
# Optional: Legacy / manuell zugewiesene Enterprise-Preise
# STRIPE_PRICE_PRO=price_...
# Optional: mailto target for "Enterprise (on request)" in org settings billing; falls back to org contact_email then /contact
# NEXT_PUBLIC_ENTERPRISE_BILLING_EMAIL=sales@example.com
# Canonical public URL (invites, emails, QR). Use your real domain on Vercel, e.g.:
# NEXT_PUBLIC_APP_URL=https://www.orgflow.de
# (If unset, the incoming request Host is used before VERCEL_URL so *.vercel.app links are avoided when admins use the custom domain.)

# Email (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM="OrgFlow <noreply@your-domain.com>"
