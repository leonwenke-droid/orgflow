# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database URL for migrations (password: URL-encode special chars, e.g. ; = %3B)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Optional: if direct host is unreachable (e.g. project paused), use Session mode URI from Dashboard > Settings > Database
# DATABASE_POOLER_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: cron secret for shift reminder endpoint (GET /api/cron/shift-reminders)
# CRON_SECRET=your-secret

# Stripe Billing
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Pro tier on landing (e.g. 29 €/month) → Stripe Price ID for plan "team" in app
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_PRO=price_...
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Email (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM="OrgFlow <noreply@your-domain.com>"
