# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database URL for migrations (password: URL-encode special chars, e.g. ; = %3B)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Optional: if direct host is unreachable (e.g. project paused), use Session mode URI from Dashboard > Settings > Database
# DATABASE_POOLER_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Canonical public URL (required in production — invites, emails, Stripe redirects)
# NEXT_PUBLIC_APP_URL=https://www.orgflow.de
# (If unset, the incoming request Host is used before VERCEL_URL.)

# Rate limiting — Upstash Redis (required in production; ineffective fallback without these)
# https://console.upstash.com → Redis → REST API
# UPSTASH_REDIS_REST_URL=https://YOUR_DB.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN

# Cron secret (REQUIRED in production — protects /api/cron/*)
# Vercel Cron does NOT send Authorization: Bearer automatically — use an external scheduler
# (e.g. Upstash QStash, GitHub Actions) or Vercel Cron + middleware that adds the header.
# CRON_SECRET=your-random-secret-min-32-chars

# N8N — optional magic-link email webhook for signup
# N8N_WEBHOOK_URL_SEND_MAGIC_LINK=https://your-n8n-instance/webhook/send-magic-link

# CSP: in production enforced by default; set to 0 to use Report-Only (debugging only)
# CSP_ENFORCE=1

# Stripe Billing (required in production if billing is used)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Team plan (up to 49 members)
# STRIPE_PRICE_TEAM=price_...
# Pro plan (50+ members)
# STRIPE_PRICE_TEAM_SCALE=price_...
# Optional legacy price id
# STRIPE_PRICE_PRO=price_...
# Optional: mailto for enterprise contact in UI
# NEXT_PUBLIC_ENTERPRISE_BILLING_EMAIL=sales@example.com

# Sentry (optional — errors only sent when DSN set and NODE_ENV=production)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Suppress @sentry/nextjs warning about missing app/global-error.tsx during build
# SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1

# DSGVO — optional notify admin on deletion request
# DELETION_NOTIFY_EMAIL=admin@example.com

# Email (Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM="OrgFlow <noreply@your-domain.com>"

# Optional: seed dev admin routes (local only — routes return 404 in production)
# ADMIN_SEED_SECRET=your-dev-only-secret
